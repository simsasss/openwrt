#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99

boot() {
	case $(board_name) in
	xiaomi,mi-router-ax3000t)
		. /lib/upgrade/common.sh
		[ "$(rootfs_type)" = "tmpfs" ] && \
			logger "bootcount: initramfs mode detected, exit" && \
			return 0
		[ "$(fw_printenv -n flag_try_sys2_failed 2>&1)" = "8" ] && \
			logger "bootcount: rd03 model detected, exit" && \
			return 0
		fw_setenv -s - <<-EOF
			flag_boot_rootfs 0
			flag_boot_success 1
			flag_last_success 0
			flag_ota_reboot 0
			flag_try_sys1_failed 0
			flag_try_sys2_failed 0
		EOF
		logger "bootcount: rd23 model detected, nvram was updated"
		;;
	teltonika,rutc50|\
	teltonika,rutc50-a)
		# The bootloader falls back to the other slot unless the running
		# one is marked as successfully booted in bootconfig
		. /lib/functions.sh
		local slot record index

		slot="$(cmdline_get_var ubi.mtd)"
		[ -z "$slot" ] && [ -e /proc/device-tree/chosen/rootdisk ] && {
			if [ "$(hexdump -v -e '/1 "%02x"' /proc/device-tree/chosen/rootdisk)" = \
			     "$(hexdump -v -e '/1 "%02x"' /proc/device-tree/chosen/rootdisk-rutos-b)" ]; then
				slot=rutos-b
			else
				slot=rutos-a
			fi
		}

		case "$slot" in
		rutos-a) record='\xe1\xb0\xba\xba\x01\x00\xf9\x01\xf8\x01\xf0\x00\x3d\xd4\xfb\x95' ;;
		rutos-b) record='\xe1\xb0\xba\xba\x01\x01\xf7\x01\xf8\x00\xf0\x00\xce\xd4\x44\x08' ;;
		*) return 0 ;;
		esac

		index="$(find_mtd_index bootconfig-a)"
		[ -n "$index" ] || return 0

		# partition must hold only our 16 byte record followed by erased
		# flash (0xff), anything else gets rewritten
		echo -ne "$record" | cmp -s -n 16 - /dev/mtd$index && \
		[ "$(tail -c +17 /dev/mtd$index | tr -d '\377' | wc -c)" -eq 0 ] || {
			echo -ne "$record" | \
				mtd -q -e bootconfig-a write - bootconfig-a && \
				logger -t bootcount "$slot marked as booted successfully"
		}
		;;
	zyxel,ex5700-telenor)
		fw_setenv uboot_bootcount 0
		;;
	esac
}
