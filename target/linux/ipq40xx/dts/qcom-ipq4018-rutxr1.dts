#include "qcom-ipq4018-rutx-shiftreg.dtsi"

/ {
	model = "Teltonika RUTXR1";
	compatible = "teltonika,rutxr1";

	aliases {
		led-boot = &led_rssi0;
		led-failsafe = &led_rssi0;
		led-running = &led_rssi0;
		led-upgrade = &led_rssi0;
	};

	soc {
		gpio-export {
			/* No digital I/O on this model */
			/delete-node/ gpio_in;

			gpio_modem_reset {
				gpio-export,name = "modem_reset";
				gpio-export,output = <0>;
				gpios = <&shift_io 1 GPIO_ACTIVE_HIGH>;
			};

			gpio_modem_power {
				gpio-export,name = "modem_power";
				gpio-export,output = <0>;
				gpios = <&shift_io 2 GPIO_ACTIVE_HIGH>;
			};

			gpio_sim_select {
				gpio-export,name = "sim_sel";
				/* 0 = SIM1 ; 1 = SIM2 */
				gpio-export,output = <0>;
				gpios = <&shift_io 3 GPIO_ACTIVE_HIGH>;
			};
		};

		leds {
			compatible = "gpio-leds";

			led-0 {
				label = "green:mobile";
				gpios = <&shift_io 0 GPIO_ACTIVE_HIGH>;
			};

			led-1 {
				label = "green:sim1";
				gpios = <&shift_io 4 GPIO_ACTIVE_HIGH>;
			};

			led-2 {
				label = "green:sim2";
				gpios = <&shift_io 5 GPIO_ACTIVE_HIGH>;
			};

			led-3 {
				label = "green:3g";
				gpios = <&shift_io 6 GPIO_ACTIVE_HIGH>;
			};

			led-4 {
				label = "green:4g";
				gpios = <&shift_io 7 GPIO_ACTIVE_HIGH>;
			};

			led_rssi0: led-5 {
				label = "green:rssi0";
				gpios = <&shift_io 8 GPIO_ACTIVE_HIGH>;
			};

			led-6 {
				label = "green:rssi1";
				gpios = <&shift_io 9 GPIO_ACTIVE_HIGH>;
			};

			led-7 {
				label = "green:rssi2";
				gpios = <&shift_io 10 GPIO_ACTIVE_HIGH>;
			};

			led-8 {
				label = "green:eth";
				gpios = <&shift_io 11 GPIO_ACTIVE_HIGH>;
			};

			led-9 {
				label = "green:wifi2g";
				gpios = <&shift_io 12 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "phy0tpt";
			};

			led-10 {
				label = "green:wifi5g";
				gpios = <&shift_io 13 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "phy1tpt";
			};
		};
	};
};

/*
 * Four LAN ports on switch ports 1-4. The WAN port is a copper/SFP combo
 * port in the vendor firmware; only the copper side is described here.
 */
&swport1 {
	status = "okay";

	label = "lan1";
};

&swport2 {
	label = "lan2";
};

&swport3 {
	label = "lan3";
};

&swport4 {
	label = "lan4";
};

&wifi0 {
	status = "okay";
	qcom,ath10k-calibration-variant = "Teltonika-RUTX10";
};

&wifi1 {
	status = "okay";
	qcom,ath10k-calibration-variant = "Teltonika-RUTX10";
};
